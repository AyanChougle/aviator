rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Real-Time Global Synchronized Game Rounds (Open to all connected players)
    match /game_state/{stateId} {
      allow read, write: if true;
    }

    // 2. Real-Time Active Squadron Bets (Open to all connected players)
    match /active_bets/{betId} {
      allow read, write, delete: if true;
    }

    // 3. Pilot Profiles, Bank Details, and Balances
    match /users/{userId} {
      allow read, write: if true;
    }

    // 4. Wallet Deposits
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // 5. Withdrawal Requests
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // 6. Login and Audit Logs
    match /login_logs/{logId} {
      allow read, write: if true;
    }

    // 7. General Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
