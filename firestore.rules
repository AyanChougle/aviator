rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'carrentpedatabase@gmail.com'
      );
    }

    match /users/{userId} {
      // A pilot can only read/write their own profile.
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin() && request.auth.uid == userId;
    }

    match /login_logs/{logId} {
      // Client may create an audit record only for itself; no client reads/updates/deletes.
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /payment_logs/{logId} {
      // Client can create its own prototype payment record. Admin can inspect it.
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
